FROM node:22-bookworm-slim AS web
WORKDIR /build/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build && npm prune --omit=dev && rm -rf .next/cache

FROM python:3.13-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home shy
WORKDIR /app
COPY services/core/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY --chown=10001:10001 services/core/ ./
COPY --chown=10001:10001 services/core/intelligence_types.py ./core/intelligence_types.py
COPY --chown=10001:10001 services/model-router/app/ ./model_router/
COPY --chown=10001:10001 services/permissions/ ./permissions/
COPY --chown=10001:10001 services/tools/ ./tools/
COPY --chown=10001:10001 services/agent-runtime/ ./agent_runtime/
COPY --chown=10001:10001 services/research/ ./research/
COPY --from=web /usr/local/bin/node /usr/local/bin/node
COPY --from=web --chown=10001:10001 /build/web/ ./web/
COPY --chown=10001:10001 scripts/hosted_start.py ./hosted_start.py
ENV PYTHONUNBUFFERED=1 NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 SHY_REQUIRE_AUTH=1
USER shy
EXPOSE 10000
CMD ["python", "hosted_start.py"]
